// Sizes, limits, and type casting
#include <iostream>
#include <climits>
using namespace std;

int main() {
    cout << "int: " << sizeof(int) << " bytes, max = " << INT_MAX << endl;
    cout << "long long: " << sizeof(long long) << " bytes, max = " << LLONG_MAX << endl;
    cout << "float: " << sizeof(float) << " bytes" << endl;
    cout << "double: " << sizeof(double) << " bytes" << endl;
    cout << "char: " << sizeof(char) << " byte" << endl;
    cout << "bool: " << sizeof(bool) << " byte" << endl;

    cout << "\n7 / 2 = " << 7 / 2 << endl;
    cout << "7.0 / 2 = " << 7.0 / 2 << endl;
    cout << "(double)7 / 2 = " << (double)7 / 2 << endl;
    cout << "'A' as int = " << (int)'A' << endl;
    cout << "98 as char = " << (char)98 << endl;
    return 0;
}
